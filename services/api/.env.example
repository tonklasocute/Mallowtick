# Copy to services/api/.env and fill in. `make dev-api` loads this file.
# Never commit the real .env.

# --- Market data provider (Twelve Data) -------------------------------------
# Get a key at https://twelvedata.com/account/api-keys. Leave empty to run the
# API without a provider: data endpoints then return provider_not_configured.
TWELVEDATA_API_KEY=
# API credits per minute on your plan (Basic/free plan: 8).
TWELVEDATA_CREDITS_PER_MINUTE=8
# How long a request may wait for credits before returning rate_limited. One
# credit refills every 7.5s on the free plan, so 10s lets a request queue for it.
TWELVEDATA_MAX_WAIT=10s
TWELVEDATA_TIMEOUT=10s
# TWELVEDATA_BASE_URL=https://api.twelvedata.com

# --- Optional: Finnhub for quotes, search and earnings -----------------------
# Get a free key at https://finnhub.io/register. With a key, quotes, symbol
# search and the earnings calendar come from Finnhub (60 calls/min on the free
# plan); Twelve Data keeps candles and market status, which Finnhub's free plan
# lacks. Leave empty to use Twelve Data for everything.
FINNHUB_API_KEY=
FINNHUB_CALLS_PER_MINUTE=60
FINNHUB_MAX_WAIT=5s
FINNHUB_TIMEOUT=10s
# FINNHUB_BASE_URL=https://finnhub.io/api/v1

# Declared delivery latency of your plan: realtime | delayed | eod | unknown.
# Shown to users as-is; set it only to what your plan actually provides.
MARKET_DATA_LATENCY=unknown

# --- Caching (bounds provider credit use regardless of client count) --------
# How long quotes are reused while the market is open. With Twelve Data quotes
# on the free plan keep 5m: a Discover screen left open all session then uses
# ~550 of the 800 daily credits. With Finnhub quotes (or a paid plan) 60s is fine.
QUOTE_CACHE_TTL=5m
# Used for closed-market quotes only until the market status is known; after
# that they are kept until the next open.
QUOTE_CACHE_TTL_CLOSED=15m
STALE_RETENTION=24h
# Keeps candles, market status and USD/THB (what costs Twelve Data credits)
# across restarts, so a restart or deploy does not fetch them again. Saved every
# 5 minutes and on shutdown. A relative path starts from the working directory
# (services/api with `make dev-api`). Empty keeps the caches in memory only.
CACHE_FILE=./.cache/market-cache.json

# --- Per-client limits (one IP address, or one IPv6 /64) ----------------------
# So nobody can spend the shared provider budgets for everyone. 0 turns a limit
# off. Requests beyond the first get 429 too_many_requests.
CLIENT_REQUESTS_PER_MINUTE=120
# Shares of the vendors' budgets, spent only by calls that miss the cache; when
# one runs out, that client gets cached data or 429 rate_limited. Twelve Data's
# per-minute window stays shared (a batch quote takes up to 8 credits at once).
CLIENT_TWELVEDATA_CREDITS_PER_DAY=200
CLIENT_FINNHUB_CALLS_PER_MINUTE=45
# Who may name the client in X-Forwarded-For: the web app's /api/v1 proxy route,
# which every browser request goes through. Loopback when both run on one
# machine; the web container's address or network (e.g. 172.18.0.0/16) in
# Docker. "none" counts every request as the connecting address.
TRUSTED_PROXIES=127.0.0.1,::1

# --- Discover screen symbols (names come from the provider) ------------------
# ETF benchmarks; use "none" to hide. Index symbols (e.g. SPX) need a plan that
# includes indices.
MARKET_OVERVIEW_SYMBOLS=SPY,QQQ,DIA
# Popular stocks section; leave empty to hide it.
POPULAR_SYMBOLS=AAPL,NVDA,MSFT,TSLA

# --- Server ------------------------------------------------------------------
APP_ENV=development
API_ADDR=:8080
API_CORS_ORIGINS=http://localhost:3000
API_REQUEST_TIMEOUT=15s
API_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
LOG_FORMAT=text

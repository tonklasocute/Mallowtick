# Copy to services/api/.env and fill in. `make dev-api` loads this file.
# Never commit the real .env.

# --- Market data provider (Twelve Data) -------------------------------------
# Get a key at https://twelvedata.com/account/api-keys. Leave empty to run the
# API without a provider: data endpoints then return provider_not_configured.
TWELVEDATA_API_KEY=
# API credits per minute on your plan (Basic/free plan: 8).
TWELVEDATA_CREDITS_PER_MINUTE=8
# How long a request may wait for credits before returning rate_limited. One
# credit refills every 7.5s on the free plan, so 10s lets a request queue for it.
TWELVEDATA_MAX_WAIT=10s
TWELVEDATA_TIMEOUT=10s
# TWELVEDATA_BASE_URL=https://api.twelvedata.com

# Declared delivery latency of your plan: realtime | delayed | eod | unknown.
# Shown to users as-is; set it only to what your plan actually provides.
MARKET_DATA_LATENCY=unknown

# --- Caching (bounds provider credit use regardless of client count) --------
# How long quotes are reused while the market is open. 5m keeps a Discover
# screen left open all session (~550 credits) under the free plan's 800/day;
# 60s is fine on paid plans.
QUOTE_CACHE_TTL=5m
# Used for closed-market quotes only until the market status is known; after
# that they are kept until the next open.
QUOTE_CACHE_TTL_CLOSED=15m
STALE_RETENTION=24h

# --- Discover screen symbols (names come from the provider) ------------------
# ETF benchmarks; use "none" to hide. Index symbols (e.g. SPX) need a plan that
# includes indices.
MARKET_OVERVIEW_SYMBOLS=SPY,QQQ,DIA
# Popular stocks section; leave empty to hide it.
POPULAR_SYMBOLS=AAPL,NVDA,MSFT,TSLA

# --- Server ------------------------------------------------------------------
APP_ENV=development
API_ADDR=:8080
API_CORS_ORIGINS=http://localhost:3000
API_REQUEST_TIMEOUT=15s
API_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
LOG_FORMAT=text

# Origin of the Go API server. Read at runtime by the /api/v1 proxy route,
# so the browser only ever talks to this Next.js origin. Not exposed to the client.
API_ORIGIN=http://localhost:8080

# How often visible screens refresh quotes, in seconds. The API caches quotes
# server-side (QUOTE_CACHE_TTL), so this only controls how often the browser asks.
NEXT_PUBLIC_QUOTE_REFRESH_SECONDS=60
